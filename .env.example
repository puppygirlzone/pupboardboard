# Copy to .env and fill in what you have. Any source left blank just shows
# "Not set up" on the dashboard. Never commit your real .env.
#
# Not using Docker? You can skip this file: the Settings page (gear button,
# top right) does the same on the computer running pupboard. Anything set
# here wins over the Settings page, which then shows that field as locked.
#
# QUOTING: wrap a value in SINGLE quotes if it contains $ # spaces or quotes,
# e.g. NAVIDROME_PASSWORD='pa$$ #word'. Without quotes Docker treats $ as a
# variable and anything after " #" as a comment; double quotes still mangle $.
#
# URLs: use the LAN IP of each server (http://192.168.1.10:4533), not
# localhost. Inside the container, localhost is the dashboard itself.

# --- Server ---
PORT=8742
# Set to 1 to use fake, deliberately flaky data instead of your servers.
DEMO_MODE=0

# --- Clock ---
# Your time zone, as a name from https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# (e.g. Europe/London, America/New_York, Australia/Sydney). Set this if the
# clock is wrong: some privacy browser settings hide your real time zone.
# Docker's usual TZ=... also works. Blank = use the browser's own zone.
TIME_ZONE=
# 24h (default) or 12h
CLOCK_FORMAT=24h

# --- Steam (free) ---
# API key: https://steamcommunity.com/dev/apikey
# SteamID64 (17 digits): visible in your profile URL or via https://steamid.io
# Your profile's "Game details" privacy must be Public for playtime to show.
STEAM_API_KEY=
STEAM_ID=

# --- Navidrome ---
# The URL as seen from where the dashboard runs (inside Docker, not "localhost").
# e.g. NAVIDROME_URL=http://192.168.1.10:4533
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# --- Jellyfin ---
# API key: Jellyfin Dashboard -> API Keys -> +
# e.g. JELLYFIN_URL=http://192.168.1.10:8096
JELLYFIN_URL=
JELLYFIN_API_KEY=

# --- News (RSS / Atom, free, no keys) ---
# Feeds live in config/feeds.txt, one per line (copy config/feeds.example.txt).
# Without that file you get Hacker News, Phoronix and Ars Technica.
# Use a different file:
# RSS_FEEDS_FILE=./config/feeds.txt
# Or, for a short list without a file: comma-separated "Name|url" ("off" disables).
# RSS_FEEDS=Hacker News|https://hnrss.org/frontpage

# --- Settings page ---
# Set to 0 to turn the Settings page off. (It is always off inside Docker,
# and only ever works in a browser on the computer running pupboard.)
# SETUP_PAGE=1
# Which network address to listen on. Default 0.0.0.0 (every device on your
# network can open the dashboard); 127.0.0.1 = this computer only.
# HOST=0.0.0.0

# --- Optional tuning (defaults shown) ---
# REQUEST_TIMEOUT_MS=8000
# STEAM_CACHE_SECONDS=300
# NAVIDROME_CACHE_SECONDS=60
# JELLYFIN_CACHE_SECONDS=300
# RSS_CACHE_SECONDS=900
# BACKGROUND_REFRESH_MINUTES=30
